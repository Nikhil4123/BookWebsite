            "url": { "raw": "{{baseUrl}}/api/v1/market/listings/resale", "host": ["{{baseUrl}}"], "path": ["api","v1","market","listings","resale"] },
            "body": { "mode": "raw", "raw": "{\n  \"bookRef\": \"{{bookId}}\",\n  \"price\": 15,\n  \"condition\": \"good\",\n  \"deliveryOptions\": [\"ship\"],\n  \"location\": \"Earth\",\n  \"photos\": [],\n  \"notes\": \"Gently used\",\n  \"complianceAck\": true\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "const res = pm.response.json();",
                "if (res && res.data && res.data._id) pm.collectionVariables.set('listingId', res.data._id);"
