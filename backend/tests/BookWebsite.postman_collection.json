      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/sign-up", "host": ["{{baseUrl}}"], "path": ["api","v1","sign-up"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demoUser\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret123\",\n  \"address\": \"Earth\"\n}"
            }
          }
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/sign-in", "host": ["{{baseUrl}}"], "path": ["api","v1","sign-in"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demoUser\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}",
                  "if (res && res.id) {",
                  "  pm.collectionVariables.set('userId', res.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
